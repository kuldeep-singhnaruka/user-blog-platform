# Copy to .env in the project root. The app also runs with built-in local defaults
# if this file is missing (SQLite, dev JWT secret, demo seed on).

APP_NAME=Fieldnotes
ENVIRONMENT=development

# sqlite (default) or postgresql+psycopg://blog:blog@localhost:5432/blog
DATABASE_URL=sqlite:///./data/blog.db

# Generate a long random value before you share a deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2000000

# Public Wikipedia summary lookup. No key required.
WIKIPEDIA_API_BASE=https://en.wikipedia.org/api/rest_v1
EXTERNAL_TIMEOUT_SECONDS=3
EXTERNAL_RETRIES=2

# Optional second provider. Used only when both values are set.
EXTERNAL_API_BASE=
EXTERNAL_API_KEY=

# Inbound webhook shared secret (header: X-Webhook-Token)
WEBHOOK_SECRET=dev-webhook-secret

RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
LIST_CACHE_SECONDS=10

SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@fieldnotes.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Fieldnotes Admin
